{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Transcript Plus",
  "version": "0.1.0",
  "identifier": "com.transcriptplus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Transcript Plus", "width": 1320, "height": 860, "minWidth": 980, "minHeight": 640 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": { "resources/core/": "core/" },
    "macOS": { "minimumSystemVersion": "14.0" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
